[NetDev]
Name=wg0
Kind=wireguard

[WireGuard]
ListenPort={{ wireguard_port }}

{% for host in groups['all'] if host != inventory_hostname %}
{% if hostvars[host].wireguard_public_key is defined and hostvars[host]['wireguard_address'] is defined and hostvars[host]['wireguard_public_ipv6'] is defined %}
[WireGuardPeer]
PublicKey={{ hostvars[host].wireguard_public_key }}
AllowedIPs={{ hostvars[host]['wireguard_address'] }}/128
Endpoint=[{{ hostvars[host]['wireguard_public_ipv6'] }}]:{{ wireguard_port }}
{% else %}
# WARNING: Peer configuration for {{ host }} was skipped.
# Reason: Missing required variables ('wireguard_public_key', 'wireguard_address', or 'wireguard_public_ipv6').
{% endif %}

{% endfor %}
