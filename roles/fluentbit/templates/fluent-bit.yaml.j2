---
service:
  flush: 1
  log_level: info
  http_server: false
  parsers_file: parsers.yaml

pipeline:
  inputs:
    - name: systemd
{% if fluentbit_nginx_logs_enabled %}
    - name: tail
      path: /var/log/nginx/*.access.log
      parser: nginx_access
    - name: tail
      path: /var/log/nginx/*.error.log
      parser: nginx_error
{% endif %}

  outputs:
    - name: loki
      match: '*'
      host: {{ fluentbit_loki_endpoint }}
      port: 3100
      labels: agent=fluent-bit
